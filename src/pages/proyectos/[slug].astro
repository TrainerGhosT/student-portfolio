---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechPill from '../../components/TechPill.astro';
import Icon from '../../components/UiIcon.astro';
import { formatPeriod, getEntry, renderMarkdown } from '../../lib/content';

const { slug = '' } = Astro.params;
const project = await getEntry('projects', slug);
if (!project) return Astro.rewrite('/404');

const { data, body } = project;
---

<BaseLayout title={data.title} description={data.summary}>
	<article class="container-page max-w-4xl pt-8 sm:pt-12">
		<a href="/proyectos" class="link inline-flex items-center gap-1.5 text-sm">
			<Icon name="arrow-left" size={14} /> Proyectos
		</a>

		<header class="mt-6">
			<p class="text-sm text-gray-400">{[data.context, formatPeriod(data.date)].filter(Boolean).join(' · ')}</p>
			<h1 class="mt-2 text-4xl leading-tight sm:text-5xl">{data.title}</h1>
			<p class="mt-4 text-lg text-gray-300">{data.summary}</p>

			{
				data.tags && data.tags.length > 0 && (
					<div class="mt-5 flex flex-wrap gap-1.5" aria-label="Tecnologías">
						{data.tags.map((t) => (
							<TechPill name={t} />
						))}
					</div>
				)
			}

			{
				(data.repo || data.demo) && (
					<div class="mt-7 flex flex-wrap gap-3">
						{data.demo && (
							<a href={data.demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
								<Icon name="eye" size={16} /> Ver demo
							</a>
						)}
						{data.repo && (
							<a href={data.repo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
								<Icon name="github" size={16} /> Código fuente
							</a>
						)}
					</div>
				)
			}
		</header>

		{data.image && <img src={data.image} alt={data.imageAlt ?? ''} class="mt-10 block w-full rounded-2xl border border-gray-800 shadow-md" />}

		<div class="prose-portfolio mt-10 text-[1.05rem]" set:html={renderMarkdown(body)} />
	</article>
</BaseLayout>
