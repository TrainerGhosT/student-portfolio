---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getEntries } from '../../lib/content';

const projects = await getEntries('projects');
const tags = [...new Set(projects.flatMap((p) => p.data.tags ?? []))].sort((a, b) => a.localeCompare(b, 'es'));
---

<BaseLayout title="Proyectos" description="Proyectos académicos, personales y profesionales.">
	<section class="container-page pt-10 pb-6 sm:pt-16">
		<p class="eyebrow mb-2">Portafolio</p>
		<h1 class="text-4xl sm:text-5xl">Proyectos</h1>
		<p class="mt-4 max-w-2xl text-lg text-gray-300">
			Proyectos desarrollados en la universidad, en el trabajo y por iniciativa propia. Filtra por tecnología para encontrar algo específico.
		</p>

		{
			tags.length > 1 && (
				<div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar por tecnología" data-filters>
					<button type="button" data-tag="" aria-pressed="true" class="filter">Todos</button>
					{tags.map((t) => (
						<button type="button" data-tag={t} aria-pressed="false" class="filter">
							{t}
						</button>
					))}
				</div>
			)
		}
	</section>

	<section class="container-page pb-10">
		<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-projects>
			{
				projects.map((p) => (
					<li data-tags={(p.data.tags ?? []).join('|')}>
						<ProjectCard project={p} />
					</li>
				))
			}
		</ul>
		{projects.length === 0 && <p class="text-gray-400">Aún no hay proyectos publicados.</p>}
	</section>
</BaseLayout>

<style>
	.filter {
		padding: 0.35rem 0.9rem;
		border-radius: 999rem;
		font: inherit;
		font-size: var(--tpl-text-sm);
		color: var(--gray-300);
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		border: 1px solid var(--gray-800);
		cursor: pointer;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.filter:hover {
		color: var(--gray-100);
	}

	.filter[aria-pressed='true'] {
		color: var(--accent-text-over);
		background: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	li[hidden] {
		display: none;
	}
</style>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filters] button');
	const items = document.querySelectorAll<HTMLElement>('[data-projects] > li');
	buttons.forEach((btn) =>
		btn.addEventListener('click', () => {
			const tag = btn.dataset.tag ?? '';
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
			items.forEach((li) => (li.hidden = !!tag && !(li.dataset.tags ?? '').split('|').includes(tag)));
		}),
	);
</script>
