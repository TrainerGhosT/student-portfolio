---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getEntries } from '../../lib/content';

const projects = await getEntries('projects');
const tags = [...new Set(projects.flatMap((p) => p.data.tags ?? []))].sort((a, b) => a.localeCompare(b, 'es'));
---

<BaseLayout title="Proyectos" description="Proyectos académicos, personales y profesionales de Dylan Montoya.">
	<section class="container-page pt-14 pb-6 sm:pt-20">
		<p class="eyebrow mb-2">Portafolio</p>
		<h1 class="text-3xl sm:text-4xl">Proyectos</h1>
		<p class="mt-3 max-w-2xl text-zinc-600 dark:text-zinc-400">
			Proyectos desarrollados en la universidad y por iniciativa propia. Filtra por tecnología para encontrar algo específico.
		</p>

		{
			tags.length > 0 && (
				<div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar por tecnología" data-filters>
					<button type="button" data-tag="" aria-pressed="true" class="filter-btn">Todos</button>
					{tags.map((t) => (
						<button type="button" data-tag={t} aria-pressed="false" class="filter-btn">
							{t}
						</button>
					))}
				</div>
			)
		}
	</section>

	<section class="container-page pb-10">
		<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-projects>
			{
				projects.map((p) => (
					<li data-tags={(p.data.tags ?? []).join('|')}>
						<ProjectCard project={p} />
					</li>
				))
			}
		</ul>
		{projects.length === 0 && <p class="text-zinc-500">Aún no hay proyectos publicados.</p>}
	</section>
</BaseLayout>

<style>
	@reference '../../styles/global.css';
	.filter-btn {
		@apply rounded-full border border-zinc-200 px-3 py-1 text-xs font-medium text-zinc-600 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-600;
	}
	.filter-btn[aria-pressed='true'] {
		@apply border-zinc-900 bg-zinc-900 text-white dark:border-zinc-100 dark:bg-zinc-100 dark:text-zinc-900;
	}
</style>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filters] button');
	const items = document.querySelectorAll<HTMLElement>('[data-projects] > li');
	buttons.forEach((btn) =>
		btn.addEventListener('click', () => {
			const tag = btn.dataset.tag ?? '';
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
			items.forEach((li) => {
				li.hidden = !!tag && !(li.dataset.tags ?? '').split('|').includes(tag);
			});
		}),
	);
</script>
