---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminEditor from '../../../components/AdminEditor.astro';
import Icon from '../../../components/Icon.astro';
import { getEntry } from '../../../lib/content';
import { COLLECTIONS, isCollection, type ListCollection } from '../../../lib/schema';

const { collection, slug = '' } = Astro.params;
if (!isCollection(collection) || COLLECTIONS[collection].kind !== 'list') return Astro.rewrite('/404');
const def = COLLECTIONS[collection];

const isNew = slug === 'nuevo';
const doc = isNew ? null : await getEntry(collection as ListCollection, slug);
if (!isNew && !doc) return Astro.rewrite('/404');

const data = (doc?.data ?? {}) as Record<string, any>;
const title = isNew ? `Nuevo ${def.singular}` : String(data[def.titleField ?? 'title'] ?? slug);
const publicUrl = collection === 'projects' && !isNew ? `/proyectos/${slug}` : null;
---

<AdminLayout title={title}>
	<a href={`/admin/${collection}`} class="inline-flex items-center gap-1.5 text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100">
		<Icon name="arrow-left" size={14} /> {def.label}
	</a>
	<div class="mt-3 mb-6 flex items-center justify-between gap-4">
		<h1 class="text-2xl">{title}</h1>
		{
			publicUrl && (
				<a href={publicUrl} target="_blank" class="btn btn-secondary shrink-0">
					<Icon name="external" size={16} /> Ver publicado
				</a>
			)
		}
	</div>
	<AdminEditor collection={collection} def={def} slug={isNew ? '' : slug} data={data} body={doc?.body ?? ''} isNew={isNew} />
</AdminLayout>
