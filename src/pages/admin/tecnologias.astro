---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/UiIcon.astro';
import { getEntries, getSingle, parseSkillGroups } from '../../lib/content';
import { getTechCatalog, isSeeded, svgDataUri, techKey } from '../../lib/tech';

const [catalog, projects, experience, skillsDoc] = await Promise.all([
	getTechCatalog(),
	getEntries('projects'),
	getEntries('experience'),
	getSingle('skills'),
]);

// Dónde se usa cada tecnología
const usage = new Map<string, { name: string; where: Set<string> }>();
const track = (name: string, where: string) => {
	const k = techKey(name);
	if (!usage.has(k)) usage.set(k, { name, where: new Set() });
	usage.get(k)!.where.add(where);
};
projects.forEach((p) => p.data.tags?.forEach((t) => track(t, 'Proyectos')));
experience.forEach((e) => e.data.stack?.forEach((t) => track(t, 'Experiencia')));
const skillGroups = parseSkillGroups(skillsDoc?.body ?? '');
skillGroups.forEach((g) => g.items.forEach((i) => (techKey(i) in catalog || g.items.some((x) => techKey(x) in catalog)) && track(i, 'Habilidades')));

const keys = [...new Set([...Object.keys(catalog), ...usage.keys()])];
const rows = keys
	.map((k) => {
		const entry = catalog[k];
		const used = usage.get(k);
		return { key: k, name: entry?.name ?? used!.name, entry, where: used ? [...used.where] : [], seeded: isSeeded(k) };
	})
	.sort((a, b) => a.name.localeCompare(b.name, 'es'));

const missing = rows.filter((r) => !r.entry || r.entry.source === 'none').length;
const editName = Astro.url.searchParams.get('edit') ?? '';
const sourceLabel = { svgl: 'svgl', lucide: 'Lucide', none: 'Sin ícono' } as const;
---

<AdminLayout title="Tecnologías">
	<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<h1 class="text-2xl">Tecnologías e íconos</h1>
			<p class="mt-1 text-sm text-zinc-500">
				El ícono que acompaña cada etiqueta en el sitio. Logos de marca de
				<a class="link" href="https://svgl.app" target="_blank" rel="noopener">svgl</a> o íconos genéricos de
				<a class="link" href="https://lucide.dev/icons" target="_blank" rel="noopener">Lucide</a>.
			</p>
		</div>
		<form method="post" action="/api/admin/tech-icons" class="flex gap-2">
			<input type="hidden" name="_action" value="add" />
			<input name="name" class="field" placeholder="Nueva tecnología" required maxlength="60" />
			<button class="btn btn-secondary shrink-0"><Icon name="plus" size={16} /> Agregar</button>
		</form>
	</div>

	{missing > 0 && <p class="mt-4 text-sm text-amber-700 dark:text-amber-400">{missing} tecnologías no tienen ícono.</p>}

	<ul class="card mt-6 divide-y divide-zinc-200 dark:divide-zinc-800">
		{
			rows.map((r) => (
				<li class="flex flex-wrap items-center gap-4 px-4 py-3" data-row={r.name}>
					<span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-zinc-200 bg-white p-1.5 dark:border-zinc-700 dark:bg-zinc-900">
						{r.entry?.source === 'svgl' && r.entry.light && <img src={svgDataUri(r.entry.light)} alt="" class:list={['max-h-full max-w-full', r.entry.dark && 'dark:hidden']} />}
						{r.entry?.source === 'svgl' && r.entry.dark && <img src={svgDataUri(r.entry.dark)} alt="" class="hidden max-h-full max-w-full dark:block" />}
						{r.entry?.source === 'lucide' && r.entry.light && <span class="size-6 text-violet-600 dark:text-violet-400 [&>svg]:size-full" set:html={r.entry.light} />}
						{(!r.entry || r.entry.source === 'none') && <span class="text-xs text-zinc-400">—</span>}
					</span>
					<span class="min-w-0 flex-1">
						<span class="block font-medium text-zinc-900 dark:text-zinc-100">{r.name}</span>
						<span class="block text-xs text-zinc-500">
							{r.entry ? sourceLabel[r.entry.source] : 'Sin ícono'}
							{r.entry?.ref && ` · ${r.entry.ref}`}
							{r.where.length > 0 ? ` · Usada en ${r.where.join(', ')}` : ' · No se usa en el contenido'}
						</span>
					</span>
					<span class="flex flex-wrap gap-2">
						<button type="button" class="btn btn-secondary !px-3 !py-1.5 text-xs" data-pick={r.name}>
							<Icon name="pencil" size={14} /> Cambiar ícono
						</button>
						<form method="post" action="/api/admin/tech-icons">
							<input type="hidden" name="name" value={r.name} />
							{r.seeded ? (
								<button name="_action" value="reset" class="btn btn-secondary !px-3 !py-1.5 text-xs" title="Volver al ícono original">
									Restablecer
								</button>
							) : (
								r.entry && (
									<button name="_action" value="remove" class="btn btn-danger !px-3 !py-1.5 text-xs" data-confirm>
										<Icon name="trash" size={14} /> Quitar
									</button>
								)
							)}
						</form>
					</span>
				</li>
			))
		}
	</ul>

	<!-- Selector de íconos -->
	<dialog id="picker" class="m-auto w-[min(44rem,calc(100vw-2rem))] rounded-xl border border-zinc-200 bg-white p-0 text-zinc-800 shadow-xl backdrop:bg-black/50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200">
		<div class="flex items-center justify-between border-b border-zinc-200 px-5 py-4 dark:border-zinc-800">
			<h2 class="text-base">Ícono para <span data-picker-name></span></h2>
			<button type="button" class="rounded-md p-1 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-close aria-label="Cerrar"><Icon name="x" /></button>
		</div>
		<div class="space-y-4 p-5">
			<div class="flex gap-2 text-sm" role="tablist">
				<button type="button" class="btn btn-secondary !py-1.5 aria-selected:!border-violet-500" aria-selected="true" data-tab="svgl">Logos (svgl)</button>
				<button type="button" class="btn btn-secondary !py-1.5 aria-selected:!border-violet-500" aria-selected="false" data-tab="lucide">Íconos (Lucide)</button>
				<form method="post" action="/api/admin/tech-icons" class="ml-auto">
					<input type="hidden" name="_action" value="none" />
					<input type="hidden" name="name" data-picker-input />
					<button class="btn btn-secondary !py-1.5">Sin ícono</button>
				</form>
			</div>
			<input type="search" class="field" placeholder="Buscar… (p. ej. react, database, cloud)" data-search />
			<p class="text-xs text-zinc-500" data-status></p>
			<div class="grid max-h-[50vh] grid-cols-3 gap-2 overflow-y-auto sm:grid-cols-5" data-results></div>
		</div>
	</dialog>

	<form method="post" action="/api/admin/tech-icons" class="hidden" data-choose>
		<input type="hidden" name="_action" />
		<input type="hidden" name="name" />
		<input type="hidden" name="ref" />
		<input type="hidden" name="light" />
		<input type="hidden" name="dark" />
	</form>

	<script define:vars={{ editName }}>
		const dialog = document.getElementById('picker');
		const results = dialog.querySelector('[data-results]');
		const statusEl = dialog.querySelector('[data-status]');
		const search = dialog.querySelector('[data-search]');
		const choose = document.querySelector('[data-choose]');
		let provider = 'svgl';
		let current = '';
		let timer;

		const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

		async function run() {
			const q = search.value.trim();
			if (provider === 'svgl' && !q) {
				results.innerHTML = '';
				statusEl.textContent = 'Escribe el nombre de la marca o tecnología.';
				return;
			}
			statusEl.textContent = 'Buscando…';
			try {
				const res = await fetch(`/api/admin/tech-icons?provider=${provider}&q=${encodeURIComponent(q)}`);
				const data = await res.json();
				if (data.error) throw new Error(data.error);
				statusEl.textContent = data.results.length ? `${data.results.length} resultados` : 'Sin resultados.';
				results.innerHTML = data.results
					.map((r, i) =>
						provider === 'svgl'
							? `<button type="button" data-i="${i}" class="flex flex-col items-center gap-2 rounded-lg border border-zinc-200 p-3 text-center text-xs hover:border-violet-500 dark:border-zinc-700"><img src="${esc(r.light)}" alt="" class="h-8 w-8 object-contain" loading="lazy"><span class="line-clamp-2">${esc(r.title)}</span></button>`
							: `<button type="button" data-i="${i}" class="flex flex-col items-center gap-2 rounded-lg border border-zinc-200 p-3 text-center text-xs hover:border-violet-500 dark:border-zinc-700"><img src="${esc(r.preview)}" alt="" class="h-7 w-7 dark:invert" loading="lazy"><span class="break-all">${esc(r.name)}</span></button>`,
					)
					.join('');
				results.querySelectorAll('[data-i]').forEach((btn) =>
					btn.addEventListener('click', () => {
						const r = data.results[Number(btn.dataset.i)];
						choose.elements._action.value = provider;
						choose.elements.name.value = current;
						choose.elements.ref.value = provider === 'svgl' ? r.title : r.name;
						choose.elements.light.value = provider === 'svgl' ? r.light : '';
						choose.elements.dark.value = provider === 'svgl' ? r.dark || '' : '';
						statusEl.textContent = 'Guardando…';
						choose.submit();
					}),
				);
			} catch (err) {
				statusEl.textContent = `Error: ${err.message}`;
				results.innerHTML = '';
			}
		}

		function open(name) {
			current = name;
			dialog.querySelector('[data-picker-name]').textContent = name;
			dialog.querySelector('[data-picker-input]').value = name;
			search.value = name.replace(/\s*\/.*$/, '');
			dialog.showModal();
			run();
		}

		document.querySelectorAll('[data-pick]').forEach((b) => b.addEventListener('click', () => open(b.dataset.pick)));
		dialog.querySelector('[data-close]').addEventListener('click', () => dialog.close());
		dialog.querySelectorAll('[data-tab]').forEach((tab) =>
			tab.addEventListener('click', () => {
				provider = tab.dataset.tab;
				dialog.querySelectorAll('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
				run();
			}),
		);
		search.addEventListener('input', () => {
			clearTimeout(timer);
			timer = setTimeout(run, 300);
		});
		document.querySelectorAll('[data-confirm]').forEach((b) =>
			b.addEventListener('click', (e) => {
				if (!confirm('¿Quitar esta tecnología del catálogo?')) e.preventDefault();
			}),
		);
		if (editName) open(editName);
	</script>
</AdminLayout>
