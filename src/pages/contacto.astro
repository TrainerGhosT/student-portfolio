---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactChannels from '../components/ContactChannels.astro';
import ContactForm from '../components/ContactForm.astro';
import { getSingle } from '../lib/content';

const profile = (await getSingle('profile'))!.data;
---

<BaseLayout title="Contacto" description={`Formas de contactar a ${profile.name}: correo, WhatsApp o formulario.`}>
	<section class="container-page pt-10 pb-8 sm:pt-16">
		<p class="eyebrow mb-2">Contacto</p>
		<h1 class="text-4xl sm:text-5xl">Hablemos</h1>
		<p class="mt-4 max-w-2xl text-lg text-gray-300">
			Escríbeme por el medio que prefieras. Con el formulario el mensaje me llega por correo, por WhatsApp o por ambos.
		</p>
	</section>

	<section class="container-page grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
		<ContactChannels profile={profile} />
		<ContactForm />
	</section>
</BaseLayout>
