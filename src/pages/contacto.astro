---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactChannels from '../components/ContactChannels.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import { getSingle } from '../lib/content';
import { profileWhatsapp } from '../lib/whatsapp';

const profile = (await getSingle('profile'))!.data;
---

<BaseLayout title="Formas de Contacto" description={`Formas de contactar a ${profile.name}: correo, WhatsApp o formulario.`}>
	<div class="stack gap-20">
		<main class="wrapper stack gap-10">
			<Hero title="Formas de Contacto" tagline="Escríbeme por el medio que prefieras: correo, WhatsApp o el formulario." />

			<div class="cards-row"><ContactChannels profile={profile} part="cards" /></div>

			<div class="layout">
				<ContactChannels profile={profile} part="whatsapp" />
				<ContactForm waPhone={profileWhatsapp(profile)} />
			</div>
		</main>
	</div>
</BaseLayout>

<style>
	.cards-row {
		width: 100%;
		max-width: 1200px;
		margin-inline: auto;
	}

	.layout {
		display: grid;
		gap: 2rem;
		width: 100%;
		max-width: 1200px;
		margin-inline: auto;
	}

	@media (min-width: 64em) {
		.layout {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			align-items: start;
			gap: 2.5rem;
		}
	}
</style>
