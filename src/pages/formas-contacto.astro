---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import { iconPaths } from '../components/IconPaths';
import Grid from '../components/Grid.astro';

type IconType = keyof typeof iconPaths;

interface ContactItem {
  type: string;
  value: string;
  icon: IconType;
  url?: string;
}

interface ContactData {
  phones: ContactItem[];
  emails: ContactItem[];
  social: ContactItem[];
}

const contactData: ContactData = {
  phones: [
    { type: "Celular", value: "+506 8686-1329", icon: "device-mobile" }
  ],
  emails: [
    { type: "Personal", value: "dylanmont15@gmail.com", icon: "envelope-simple" },
    { type: "Institucional", value: "dylan.montoya.matarrita@cuc.cr", icon: "paper-plane-tilt" }
  ],
  social: [
    { type: "LinkedIn", value: "linkedin.com/in/dylan", icon: "linkedin-logo", url: "https://linkedin.com/in/dylan" },
    { type: "GitHub", value: "github.com/dylan", icon: "github-logo", url: "https://github.com/dylan" }
  ]
};
---
<BaseLayout title="Formas de Contacto | Portafolio Personal" description="Información de contacto de Dylan">
    <div class="stack gap-20">
        <main class="wrapper about">
            <Hero
                title="Formas de Contacto"
                tagline="Aquí encontrarás todas las formas de contactarme"
            />

            <section class="contact-sections">
                <div class="content-wrapper">
                    <div class="content">
                        <h3 class="section-title">Teléfonos</h3>
			  <div class="contact-cards">
				{contactData.phones.map(item => (
				  <div class="contact-card">
					<div class="contact-info">
					<Icon icon={item.icon} size="1.8rem" gradient />
					  <Pill>{item.type}</Pill>
					  <a href={`tel:${item.value.replace(/\D/g,'')}`}>{item.value}</a>
					</div>
				  </div>
				))}
			  </div>
  
			  <h3 class="section-title">Correos</h3>
			  <div class="contact-cards">
				{contactData.emails.map(item => (
				  <div class="contact-card">
					<div class="contact-info">
					<Icon icon={item.icon} size="1.8rem" gradient />
					  <Pill>{item.type}</Pill>
					  <a href={`mailto:${item.value}`}>{item.value}</a>
					</div>
				  </div>
				))}
			  </div>
  
			  <h3 class="section-title">Redes Sociales</h3>
			  <div class="contact-cards">
				{contactData.social.map(item => (
				  <div class="contact-card">
					<div class="contact-info">
					<Icon icon={item.icon} size="1.8rem" gradient />
					  <Pill>{item.type}</Pill>
					  <a href={item.url} target="_blank" rel="noopener noreferrer">
						{item.value}
					  </a>
					</div>
				  </div>
				))}
			  </div>
			</div>
		  </Grid>
		</section>
	  </main>
	</div>
  </BaseLayout>
  
  <style>
    .contact-sections {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .content-wrapper {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .content {
        width: 100%;
    }

    .section-title {
        margin-bottom: 1.5rem;
        margin-top: 1.5rem;
        font-size: var(--text-2xl);
        text-align: center;
    }

    .contact-cards {
        display: grid;
        gap: 2rem;
    }

    .contact-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.5rem;
        background: var(--gray-999_40);
        border-radius: 0.75rem;
        box-shadow: var(--shadow-sm);
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
    }

    @media (min-width: 50em) {
        .contact-cards {
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2.5rem;
        }
    }
</style>