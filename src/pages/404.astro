---
import BaseLayout from '../layouts/BaseLayout.astro';
Astro.response.status = 404;
---

<BaseLayout title="Página no encontrada" noindex>
	<section class="container-page flex flex-col items-start py-24 sm:py-32">
		<p class="eyebrow mb-2">Error 404</p>
		<h1 class="text-3xl sm:text-4xl">Esta página no existe</h1>
		<p class="mt-3 text-zinc-600 dark:text-zinc-400">Puede que el enlace esté desactualizado.</p>
		<a href="/" class="btn btn-primary mt-8">Volver al inicio</a>
	</section>
</BaseLayout>
