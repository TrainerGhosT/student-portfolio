---
import BaseLayout from '../layouts/BaseLayout.astro';
import EducationList from '../components/EducationList.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';
import SkillGroups from '../components/SkillGroups.astro';
import Icon from '../components/UiIcon.astro';
import { computeAge, formatBirthDate, getEntries, getSingle, parseSkillGroups, renderMarkdown } from '../lib/content';

const [profileDoc, skillsDoc, experience, education, projects] = await Promise.all([
	getSingle('profile'),
	getSingle('skills'),
	getEntries('experience'),
	getEntries('education'),
	getEntries('projects'),
]);

const profile = profileDoc!.data;
const current = experience.find((e) => !e.data.end);
const featured = (projects.some((p) => p.data.featured) ? projects.filter((p) => p.data.featured) : projects).slice(0, 4);
const skills = parseSkillGroups(skillsDoc?.body ?? '');

// Edad calculada en cada visita (hora de Costa Rica): siempre está al día.
const display = profile.ageDisplay ?? 'age';
const age = profile.birthDate ? computeAge(profile.birthDate) : null;
const ageLabel = display === 'birthdate' ? 'Fecha de nacimiento' : 'Edad';
const ageValue =
	profile.birthDate && display !== 'none'
		? display === 'birthdate'
			? formatBirthDate(profile.birthDate)
			: display === 'both'
				? `${age} años · ${formatBirthDate(profile.birthDate)}`
				: `${age} años`
		: null;
---

<BaseLayout>
	<!-- Hero -->
	<section class="container-page pt-10 pb-16 sm:pt-16 sm:pb-24">
		<div class="grid items-start gap-12 lg:grid-cols-[1fr_21rem]">
			<div>
				{
					profile.availability && (
						<p class="badge mb-6">
							<span class="size-1.5 rounded-full bg-accent-regular" aria-hidden="true" />
							{profile.availability}
						</p>
					)
				}
				<h1 class="text-4xl leading-[1.05] sm:text-6xl">{profile.name}</h1>
				<p class="mt-4 text-xl text-link sm:text-2xl" style="font-family: var(--font-brand); font-weight: 500;">
					{profile.headline}
				</p>
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-300">{profile.tagline}</p>

				<div class="mt-9 flex flex-wrap gap-3">
					<a href="/contacto" class="btn btn-primary !px-6 !py-3 text-base"><Icon name="mail" size={16} /> Contactarme</a>
					<a href="/cv" class="btn btn-secondary !px-5 !py-3 text-base"><Icon name="file" size={16} /> Ver CV</a>
					<a href="/cv.pdf?descargar" class="btn btn-secondary !px-5 !py-3 text-base" download="Dylan_Montoya_CV.pdf">
						<Icon name="download" size={16} /> Descargar
					</a>
				</div>
			</div>

			<aside class="card p-6 text-sm" aria-label="Resumen">
				<dl class="space-y-5">
					{
						current && (
							<div>
								<dt class="text-xs text-gray-400">Actualmente</dt>
								<dd class="mt-0.5 font-medium text-gray-0">{current.data.role}</dd>
							</div>
						)
					}
					{
						profile.location && (
							<div>
								<dt class="text-xs text-gray-400">Ubicación</dt>
								<dd class="mt-0.5 flex items-center gap-1.5 font-medium text-gray-0">
									<Icon name="map-pin" size={14} class="text-link" />
									{profile.location}
								</dd>
							</div>
						)
					}
					{
						ageValue && (
							<div>
								<dt class="text-xs text-gray-400">{ageLabel}</dt>
								<dd class="mt-0.5 flex items-center gap-1.5 font-medium text-gray-0">
									<Icon name="cake" size={14} class="text-link" />
									{ageValue}
								</dd>
							</div>
						)
					}
					{
						profile.focus && profile.focus.length > 0 && (
							<div>
								<dt class="text-xs text-gray-400">Enfoque</dt>
								<dd class="mt-2 flex flex-wrap gap-1.5">
									{profile.focus.map((f) => (
										<span class="chip">{f}</span>
									))}
								</dd>
							</div>
						)
					}
				</dl>
				<div class="mt-6 flex gap-2 border-t border-gray-800 pt-5">
					{
						profile.linkedin && (
							<a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary flex-1 !px-2">
								<Icon name="linkedin" size={16} /> LinkedIn
							</a>
						)
					}
					{
						profile.github && (
							<a href={profile.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary flex-1 !px-2">
								<Icon name="github" size={16} /> GitHub
							</a>
						)
					}
				</div>
			</aside>
		</div>
	</section>

	<!-- Sobre mí -->
	<Section id="sobre-mi" eyebrow="Sobre mí" title="Software útil, procesos más simples" class="border-t border-gray-800">
		<div class="prose-portfolio max-w-3xl text-[1.05rem] sm:text-lg" set:html={renderMarkdown(profileDoc!.body)} />
	</Section>

	<!-- Experiencia -->
	{
		experience.length > 0 && (
			<Section id="experiencia" eyebrow="Trayectoria" title="Experiencia" class="border-t border-gray-800">
				<ExperienceTimeline items={experience} />
			</Section>
		)
	}

	<!-- Proyectos -->
	{
		featured.length > 0 && (
			<Section
				id="proyectos"
				eyebrow="Trabajo seleccionado"
				title="Proyectos"
				description="Una selección de proyectos académicos y personales."
				class="border-t border-gray-800"
			>
				<a slot="action" href="/proyectos" class="link inline-flex shrink-0 items-center gap-1 text-sm">
					Ver todos <Icon name="arrow-right" size={14} />
				</a>
				<ul class="grid gap-6 sm:grid-cols-2">
					{featured.map((p) => (
						<li>
							<ProjectCard project={p} />
						</li>
					))}
				</ul>
			</Section>
		)
	}

	<!-- Educación -->
	{
		education.length > 0 && (
			<Section id="educacion" eyebrow="Formación" title="Educación y certificaciones" class="border-t border-gray-800">
				<EducationList items={education} />
			</Section>
		)
	}

	<!-- Habilidades -->
	{
		skills.length > 0 && (
			<Section id="habilidades" eyebrow="Herramientas" title="Habilidades" class="border-t border-gray-800">
				<SkillGroups groups={skills} />
			</Section>
		)
	}

	<!-- Contacto -->
	<section class="container-page">
		<div class="cta card flex flex-col items-start gap-6 p-8 sm:flex-row sm:items-center sm:justify-between sm:p-12">
			<div>
				<h2 class="text-3xl">¿Conversamos?</h2>
				<p class="mt-2 max-w-xl text-gray-300">
					Si tienes una oportunidad, un proyecto o una idea en la que pueda aportar, escríbeme.
				</p>
			</div>
			<a href="/contacto" class="btn btn-primary shrink-0 !px-6 !py-3 text-base">Ir a contacto <Icon name="arrow-right" size={16} /></a>
		</div>
	</section>
</BaseLayout>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.9rem;
		border-radius: 999rem;
		font-size: var(--tpl-text-sm);
		color: var(--gray-200);
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		border: 1px solid var(--gray-800);
		box-shadow: var(--shadow-sm);
	}

	.cta {
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--gradient-subtle);
		background-blend-mode: overlay, normal;
	}
</style>
