---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Currículum" description="Currículum vitae de Dylan Montoya en PDF.">
	<section class="container-page pt-14 pb-6 sm:pt-20">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="eyebrow mb-2">Currículum</p>
				<h1 class="text-3xl sm:text-4xl">CV</h1>
				<p class="mt-3 text-zinc-600 dark:text-zinc-400">Versión actualizada en PDF.</p>
			</div>
			<div class="flex flex-wrap gap-3">
				<a href="/cv.pdf" target="_blank" rel="noopener" class="btn btn-secondary">
					<Icon name="external" size={16} /> Abrir en otra pestaña
				</a>
				<a href="/cv.pdf?descargar" download="Dylan_Montoya_CV.pdf" class="btn btn-primary">
					<Icon name="download" size={16} /> Descargar PDF
				</a>
			</div>
		</div>
	</section>

	<section class="container-page">
		<div class="card overflow-hidden">
			<object data="/cv.pdf#view=FitH" type="application/pdf" class="block h-[80vh] min-h-[32rem] w-full" aria-label="Currículum de Dylan Montoya">
				<div class="flex flex-col items-center gap-4 p-10 text-center">
					<Icon name="file" size={32} class="text-zinc-400" />
					<p class="text-zinc-600 dark:text-zinc-400">Tu navegador no puede mostrar el PDF aquí.</p>
					<a href="/cv.pdf?descargar" download="Dylan_Montoya_CV.pdf" class="btn btn-primary">
						<Icon name="download" size={16} /> Descargar CV
					</a>
				</div>
			</object>
		</div>
	</section>
</BaseLayout>
