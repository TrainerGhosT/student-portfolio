---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/UiIcon.astro';
---

<BaseLayout title="Currículum" description="Currículum vitae en PDF.">
	<section class="container-page pt-10 pb-8 sm:pt-16">
		<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="eyebrow mb-2">Currículum</p>
				<h1 class="text-4xl sm:text-5xl">CV</h1>
				<p class="mt-3 text-lg text-gray-300">Versión actualizada en PDF.</p>
			</div>
			<div class="flex flex-wrap gap-3">
				<a href="/cv.pdf" target="_blank" rel="noopener" class="btn btn-secondary">
					<Icon name="external" size={16} /> Abrir en otra pestaña
				</a>
				<a href="/cv.pdf?descargar" download="Dylan_Montoya_CV.pdf" class="btn btn-primary">
					<Icon name="download" size={16} /> Descargar PDF
				</a>
			</div>
		</div>
	</section>

	<section class="container-page">
		<div class="card overflow-hidden shadow-md">
			<object data="/cv.pdf#view=FitH" type="application/pdf" class="block h-[80vh] min-h-[32rem] w-full" aria-label="Currículum en PDF">
				<div class="flex flex-col items-center gap-4 p-10 text-center text-gray-300">
					<Icon name="file" size={32} class="text-link" />
					<p>Tu navegador no puede mostrar el PDF aquí.</p>
					<a href="/cv.pdf?descargar" download="Dylan_Montoya_CV.pdf" class="btn btn-primary">
						<Icon name="download" size={16} /> Descargar CV
					</a>
				</div>
			</object>
		</div>
	</section>
</BaseLayout>
