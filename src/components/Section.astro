---
interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	description?: string;
	class?: string;
}
const { id, eyebrow, title, description, class: className = '' } = Astro.props;
---

<section id={id} class:list={['container-page scroll-mt-20 py-14 sm:py-20', className]}>
	<div class="mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
		<div class="max-w-2xl">
			{eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
			<h2 class="text-2xl sm:text-3xl">{title}</h2>
			{description && <p class="mt-3 text-zinc-600 dark:text-zinc-400">{description}</p>}
		</div>
		<slot name="action" />
	</div>
	<slot />
</section>
