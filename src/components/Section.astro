---
interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	description?: string;
	class?: string;
}
const { id, eyebrow, title, description, class: className = '' } = Astro.props;
---

<section id={id} class:list={['container-page py-14 sm:py-20', className]}>
	<div class="mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
		<div class="max-w-2xl">
			{eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
			<h2 class="text-3xl sm:text-4xl">{title}</h2>
			{description && <p class="mt-3 text-gray-300">{description}</p>}
		</div>
		<slot name="action" />
	</div>
	<slot />
</section>
