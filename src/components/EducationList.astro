---
import { formatRange, renderMarkdown, type Doc, type Education } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
	items: Doc<Education>[];
}
const { items } = Astro.props;
const academic = items.filter((i) => i.data.kind !== 'certification');
const certs = items.filter((i) => i.data.kind === 'certification');
const groups = [
	{ title: 'Formación académica', icon: 'graduation' as const, items: academic },
	{ title: 'Certificaciones', icon: 'award' as const, items: certs },
].filter((g) => g.items.length > 0);
---

<div class="grid gap-6 md:grid-cols-2">
	{
		groups.map((group) => (
			<div class="card p-6">
				<h3 class="flex items-center gap-2 text-sm font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
					<Icon name={group.icon} size={16} /> {group.title}
				</h3>
				<ul class="mt-5 space-y-5">
					{group.items.map(({ data, body }) => (
						<li>
							<p class="font-medium text-zinc-900 dark:text-zinc-100">{data.title}</p>
							<p class="mt-0.5 text-sm text-zinc-600 dark:text-zinc-400">{data.institution}</p>
							<p class="mt-1 text-xs text-zinc-500 tabular-nums dark:text-zinc-500">
								{formatRange(data.start, data.end, data.status || 'En curso')}
							</p>
							{body && (
								<div class="prose prose-sm prose-zinc dark:prose-invert mt-2 max-w-none" set:html={renderMarkdown(body)} />
							)}
							{data.credentialUrl && (
								<a href={data.credentialUrl} target="_blank" rel="noopener noreferrer" class="link mt-1 inline-flex items-center gap-1 text-sm">
									Ver credencial <Icon name="external" size={13} />
								</a>
							)}
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>
