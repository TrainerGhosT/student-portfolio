---
import { formatRange, renderMarkdown, type Doc, type Education } from '../lib/content';
import Icon from './UiIcon.astro';

interface Props {
	items: Doc<Education>[];
}
const { items } = Astro.props;
const groups = [
	{ title: 'Formación académica', items: items.filter((i) => i.data.kind !== 'certification') },
	{ title: 'Certificaciones', items: items.filter((i) => i.data.kind === 'certification') },
].filter((g) => g.items.length > 0);
---

<div class="grid gap-6 md:grid-cols-2">
	{
		groups.map((group) => (
			<div class="card p-6 sm:p-8">
				<h3 class="eyebrow">{group.title}</h3>
				<ul class="mt-5 space-y-5">
					{group.items.map(({ data, body }) => (
						<li class="border-l-2 border-accent-overlay pl-4">
							<p class="font-medium text-gray-0" style="font-family: var(--font-brand)">
								{data.title}
							</p>
							<p class="mt-0.5 text-sm text-gray-300">{data.institution}</p>
							<p class="mt-1 text-xs text-gray-400 tabular-nums">{formatRange(data.start, data.end, data.status || 'En curso')}</p>
							{body && <div class="prose-portfolio mt-2 text-sm" set:html={renderMarkdown(body)} />}
							{data.credentialUrl && (
								<a href={data.credentialUrl} target="_blank" rel="noopener noreferrer" class="link mt-1 inline-flex items-center gap-1 text-sm">
									Ver credencial <Icon name="external" size={13} />
								</a>
							)}
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>
