---
interface Props {
	initials?: string;
	class?: string;
}
const { initials = 'DM', class: className = '' } = Astro.props;
---

<span
	class:list={[
		'inline-flex size-8 items-center justify-center rounded-lg bg-zinc-900 text-[0.8rem] font-semibold tracking-tight text-white dark:bg-zinc-100 dark:text-zinc-900',
		className,
	]}
	aria-hidden="true">{initials}</span
>
