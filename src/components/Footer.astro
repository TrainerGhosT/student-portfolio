---
import type { Profile } from '../lib/content';
import Icon from './UiIcon.astro';

interface Props {
	profile: Profile;
}
const { profile } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24">
	<div class="container-page flex flex-col gap-4 border-t border-gray-800 py-10 text-sm text-gray-400 sm:flex-row sm:items-center sm:justify-between">
		<p>© {year} {profile.name} · Hecho con Astro y Cloudflare</p>
		<div class="flex items-center gap-1">
			{
				profile.email && (
					<a href={`mailto:${profile.email}`} class="social" aria-label="Correo">
						<Icon name="mail" />
					</a>
				)
			}
			{
				profile.linkedin && (
					<a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="social" aria-label="LinkedIn">
						<Icon name="linkedin" />
					</a>
				)
			}
			{
				profile.github && (
					<a href={profile.github} target="_blank" rel="noopener noreferrer" class="social" aria-label="GitHub">
						<Icon name="github" />
					</a>
				)
			}
		</div>
	</div>
</footer>

<style>
	.social {
		display: inline-flex;
		padding: 0.5rem;
		border-radius: 999rem;
		color: var(--link-color);
		transition: background-color var(--theme-transition);
	}

	.social:hover,
	.social:focus-visible {
		background-color: var(--accent-subtle-overlay);
	}
</style>
