---
import type { Profile } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
	profile: Profile;
}
const { profile } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-zinc-200 dark:border-zinc-800">
	<div class="container-page flex flex-col gap-4 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between dark:text-zinc-400">
		<p>© {year} {profile.name}. Hecho con Astro y Cloudflare.</p>
		<div class="flex items-center gap-1">
			{
				profile.email && (
					<a href={`mailto:${profile.email}`} class="rounded-md p-2 hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="Correo">
						<Icon name="mail" />
					</a>
				)
			}
			{
				profile.linkedin && (
					<a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-md p-2 hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="LinkedIn">
						<Icon name="linkedin" />
					</a>
				)
			}
			{
				profile.github && (
					<a href={profile.github} target="_blank" rel="noopener noreferrer" class="rounded-md p-2 hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="GitHub">
						<Icon name="github" />
					</a>
				)
			}
		</div>
	</div>
</footer>
