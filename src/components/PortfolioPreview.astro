---
import type { Doc, Project } from '../lib/content';
import TechIcon from './TechIcon.astro';

interface Props {
	project: Doc<Project>;
}

const { data, slug } = Astro.props.project;
const tags = (data.tags ?? []).slice(0, 4);
---

<a class="card" href={`/proyectos/${slug}/`}>
	<span class="title">{data.title}</span>
	{
		data.image ? (
			<img src={data.image} alt={data.imageAlt || ''} loading="lazy" decoding="async" />
		) : (
			<span class="placeholder" aria-hidden="true">
				<span>{data.context ?? data.summary}</span>
			</span>
		)
	}
	{
		tags.length > 0 && (
			<span class="tags" aria-label="Tecnologías">
				{tags.map((t) => (
					<span class="tag" title={t}>
						<TechIcon name={t} size="1.1em" />
						<span class="tag-label">{t}</span>
					</span>
				))}
			</span>
		)
	}
</a>

<style>
	.card {
		display: grid;
		grid-template: auto 1fr auto / auto 1fr;
		height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: box-shadow var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-radius: 0.375rem;
	}

	img,
	.placeholder {
		grid-area: 1 / 1 / 4 / 3;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder {
		display: flex;
		align-items: flex-end;
		padding: 1.25rem 1.25rem 3.5rem;
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--gradient-accent);
		background-blend-mode: overlay, normal;
		color: hsla(0, 0%, 100%, 0.85);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 400;
	}

	.tags {
		grid-area: 3 / 1 / 4 / 3;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0.5rem;
		justify-self: start;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.6rem;
		border-radius: 999rem;
		background: var(--gray-999);
		color: var(--gray-200);
		font-family: var(--font-body);
		font-size: 0.75rem;
		box-shadow: var(--shadow-sm);
	}

	.tag-label {
		display: none;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		.title {
			border-radius: 0.9375rem;
		}

		.tag-label {
			display: inline;
		}
	}
</style>
