---
import {
	ArrowLeft, ArrowRight, Award, Briefcase, Check, Code, Download, ExternalLink, Eye, FileText,
	GraduationCap, Inbox, Layers, Mail, MapPin, Menu, MessageCircle, Moon, Pencil, Phone, Plus,
	Send, Sun, Trash2, Upload, User, X, Folder, LogOut,
} from 'lucide-static';
import { siGithub, siWhatsapp } from 'simple-icons';

const brand = (path: string) =>
	`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="${path}"/></svg>`;

// LinkedIn no tiene ícono en estos paquetes: usamos un distintivo genérico «in».
const linkedin = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg>`;

const icons = {
	'arrow-left': ArrowLeft,
	'arrow-right': ArrowRight,
	award: Award,
	briefcase: Briefcase,
	check: Check,
	code: Code,
	download: Download,
	external: ExternalLink,
	eye: Eye,
	file: FileText,
	folder: Folder,
	graduation: GraduationCap,
	inbox: Inbox,
	layers: Layers,
	mail: Mail,
	'map-pin': MapPin,
	menu: Menu,
	message: MessageCircle,
	moon: Moon,
	pencil: Pencil,
	phone: Phone,
	plus: Plus,
	send: Send,
	sun: Sun,
	trash: Trash2,
	upload: Upload,
	user: User,
	x: X,
	logout: LogOut,
	github: brand(siGithub.path),
	whatsapp: brand(siWhatsapp.path),
	linkedin,
} as const;

export type IconName = keyof typeof icons;

interface Props {
	name: IconName;
	class?: string;
	size?: number;
	label?: string;
}

const { name, class: className = '', size = 18, label } = Astro.props;

const svg = icons[name]
	.replace(/\s*class="[^"]*"/, '')
	.replace(/width="24"/, `width="${size}"`)
	.replace(/height="24"/, `height="${size}"`)
	.replace(
		'<svg',
		`<svg class="shrink-0 ${className}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'}`,
	);
---

<Fragment set:html={svg} />
