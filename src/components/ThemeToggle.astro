---
import Icon from './Icon.astro';
---

<button
	type="button"
	data-theme-toggle
	class="inline-flex size-9 items-center justify-center rounded-lg text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
	aria-label="Cambiar tema claro/oscuro"
>
	<Icon name="moon" class="dark:hidden" />
	<Icon name="sun" class="hidden dark:block" />
</button>

<script>
	for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		btn.addEventListener('click', () => {
			const dark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {}
		});
	}
</script>
