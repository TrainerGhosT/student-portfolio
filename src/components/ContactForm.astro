---
import { env } from 'cloudflare:workers';
import Icon from './Icon.astro';

interface Props {
	/** Número de WhatsApp (solo dígitos). Si no hay, solo se ofrece correo. */
	waPhone?: string | null;
}
const { waPhone } = Astro.props;
const hasWhatsapp = !!waPhone;
const siteKey = env.TURNSTILE_SITE_KEY;
const sent = Astro.url.searchParams.has('enviado');
const error = Astro.url.searchParams.get('error');
---

<form id="formulario" action="/api/contact" method="post" class="form" data-contact-form data-wa={waPhone} novalidate>
	<div class="intro">
		<h2>Envíame un mensaje</h2>
		<p>Elige cómo quieres enviarlo: a mi correo, por WhatsApp o por ambos.</p>
	</div>

	<fieldset class="channel" data-channel-group>
		<legend class="sr-only">Enviar por</legend>
		<label>
			<input type="radio" name="channel" value="email" checked />
			<span><Icon icon="envelope-simple" /> Correo</span>
		</label>
		{
			hasWhatsapp && (
				<>
					<label>
						<input type="radio" name="channel" value="whatsapp" />
						<span><Icon icon="whatsapp-logo" /> WhatsApp</span>
					</label>
					<label>
						<input type="radio" name="channel" value="both" />
						<span>Ambos</span>
					</label>
				</>
			)
		}
	</fieldset>

	<div class="row">
		<div class="field">
			<label for="cf-name">Nombre <span aria-hidden="true">*</span></label>
			<input id="cf-name" name="name" required maxlength="100" autocomplete="name" />
		</div>
		<div class="field" data-email-field>
			<label for="cf-email">Correo <span aria-hidden="true" data-email-required>*</span></label>
			<input id="cf-email" name="email" type="email" required maxlength="200" autocomplete="email" />
		</div>
	</div>

	<div class="row">
		<div class="field">
			<label for="cf-subject">Asunto <span aria-hidden="true">*</span></label>
			<input id="cf-subject" name="subject" required maxlength="150" list="cf-subjects" />
			<datalist id="cf-subjects">
				<option value="Oportunidad laboral"></option>
				<option value="Propuesta de proyecto"></option>
				<option value="Colaboración"></option>
				<option value="Consulta general"></option>
			</datalist>
		</div>
		<div class="field">
			<label for="cf-company">Empresa <span class="optional">(opcional)</span></label>
			<input id="cf-company" name="company" maxlength="120" autocomplete="organization" />
		</div>
	</div>

	<div class="field">
		<label for="cf-message">Mensaje <span aria-hidden="true">*</span></label>
		<textarea id="cf-message" name="message" rows="6" required maxlength="5000"></textarea>
	</div>

	<!-- Honeypot: invisible para personas -->
	<div class="sr-only" aria-hidden="true">
		<label>No llenar <input name="website" tabindex="-1" autocomplete="off" /></label>
	</div>

	{siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-language="es" data-theme="auto" data-turnstile></div>}

	<div class="actions">
		<p data-status role="status" aria-live="polite" class:list={['status', sent ? 'ok' : error ? 'error' : '']}>
			{sent ? '¡Gracias! Tu mensaje fue enviado.' : error}
		</p>
		<button type="submit" class="submit">
			<span data-submit-label>Enviar correo</span>
			<Icon icon="paper-plane-tilt" size="1.2em" />
		</button>
	</div>
	<p class="hint" data-wa-hint hidden>Se abrirá WhatsApp con tu mensaje listo para enviar.</p>
</form>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
	.form {
		display: grid;
		gap: 1.25rem;
		padding: 1.5rem;
		background: var(--gray-999_40);
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		scroll-margin-top: 2rem;
	}

	.intro h2 {
		font-size: var(--text-xl);
	}

	.intro p {
		margin-top: 0.5rem;
		color: var(--gray-300);
	}

	/* Selector de canal con el estilo del menú de navegación */
	.channel {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		justify-self: start;
		margin: 0;
		padding: 0.375rem;
		border: 0;
		border-radius: 999rem;
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		box-shadow: var(--shadow-md);
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-sm);
	}

	.channel label {
		position: relative;
		cursor: pointer;
	}

	.channel input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.channel span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 1rem;
		border-radius: 999rem;
		color: var(--gray-300);
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.channel label:hover span {
		color: var(--gray-100);
		background-color: var(--accent-subtle-overlay);
	}

	.channel input:checked + span {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}

	.channel input:focus-visible + span {
		outline: 2px solid var(--accent-regular);
		outline-offset: 2px;
	}

	.row {
		display: grid;
		gap: 1.25rem;
	}

	.field {
		display: grid;
		gap: 0.4rem;
	}

	.field label {
		font-family: var(--font-brand);
		font-weight: 500;
		color: var(--gray-100);
	}

	.field label span {
		color: var(--link-color);
	}

	.field label .optional {
		color: var(--gray-400);
		font-family: var(--font-body);
		font-weight: 400;
	}

	input,
	textarea {
		width: 100%;
		padding: 0.75rem 1rem;
		font: inherit;
		color: var(--gray-0);
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		box-shadow: var(--shadow-sm);
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition);
	}

	textarea {
		resize: vertical;
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--accent-regular);
		box-shadow: 0 0 0 3px var(--accent-overlay);
	}

	.actions {
		display: flex;
		flex-direction: column-reverse;
		gap: 1rem;
	}

	.status {
		font-size: var(--text-sm);
	}

	.status.ok {
		color: var(--link-color);
	}

	.status.error {
		color: #e5484d;
	}

	.submit {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.8em;
		padding: 0.8rem 2rem;
		border: 0;
		border-radius: 999rem;
		color: var(--accent-text-over);
		background: var(--gradient-accent-orange);
		box-shadow: var(--shadow-md);
		font: inherit;
		font-size: var(--text-lg);
		line-height: 1.1;
		cursor: pointer;
		overflow: hidden;
	}

	.submit.wa {
		background: #25d366;
		color: #0b1a10;
	}

	.submit::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		transition: background-color var(--theme-transition);
		mix-blend-mode: overlay;
	}

	.submit:hover::after,
	.submit:focus::after {
		background-color: hsla(var(--gray-999-basis), 0.3);
	}

	.submit:disabled {
		opacity: 0.6;
		cursor: progress;
	}

	.hint {
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.form {
			padding: 2.5rem;
		}

		.row {
			grid-template-columns: 1fr 1fr;
		}

		.actions {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>

<script>
	import { whatsappUrl } from '../lib/whatsapp';

	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	if (form) {
		const status = form.querySelector<HTMLElement>('[data-status]')!;
		const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
		const email = form.querySelector<HTMLInputElement>('#cf-email')!;
		const emailStar = form.querySelector<HTMLElement>('[data-email-required]')!;
		const turnstile = form.querySelector<HTMLElement>('[data-turnstile]');
		const waHint = form.querySelector<HTMLElement>('[data-wa-hint]')!;
		const WA_PHONE = form.dataset.wa ?? '';

		const channel = () => (new FormData(form).get('channel') as string) || 'email';

		const setStatus = (msg: string, kind: 'ok' | 'error' | '') => {
			status.textContent = msg;
			status.className = `status ${kind}`;
		};

		const sync = () => {
			const c = channel();
			const usesEmail = c !== 'whatsapp';
			email.required = usesEmail;
			emailStar.hidden = !usesEmail;
			if (turnstile) turnstile.hidden = !usesEmail;
			waHint.hidden = c === 'email';
			label.textContent = c === 'email' ? 'Enviar correo' : c === 'whatsapp' ? 'Continuar en WhatsApp' : 'Enviar por ambos';
			button.classList.toggle('wa', c === 'whatsapp');
		};
		form.addEventListener('change', (e) => {
			if ((e.target as HTMLInputElement).name === 'channel') sync();
		});
		sync();

		const buildWhatsapp = () => {
			const d = new FormData(form);
			const get = (k: string) => String(d.get(k) ?? '').trim();
			return whatsappUrl(WA_PHONE, {
				name: get('name'),
				subject: get('subject'),
				message: get('message'),
				email: get('email'),
				company: get('company'),
			});
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}
			const c = channel();

			// WhatsApp se abre de inmediato (dentro del clic) para que el navegador no lo bloquee.
			if (c !== 'email') window.open(buildWhatsapp(), '_blank', 'noopener');
			if (c === 'whatsapp') {
				setStatus('Abrimos WhatsApp con tu mensaje. Solo falta que lo envíes desde ahí.', 'ok');
				return;
			}

			button.disabled = true;
			setStatus('Enviando…', '');
			try {
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});
				const data = (await res.json()) as { ok: boolean; message: string };
				setStatus(data.message, data.ok ? 'ok' : 'error');
				if (data.ok) {
					form.reset();
					sync();
				}
			} catch {
				setStatus('No se pudo enviar. Revisa tu conexión e intenta de nuevo.', 'error');
			} finally {
				button.disabled = false;
				// @ts-expect-error turnstile lo carga el script de Cloudflare
				window.turnstile?.reset();
			}
		});
	}
</script>
