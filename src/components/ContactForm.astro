---
import { turnstileSiteKey } from '../lib/mail';
import Icon from './UiIcon.astro';

// En localhost usa la clave de prueba de Cloudflare; en dmontoya.dev, la real.
const siteKey = turnstileSiteKey(Astro.url);
const sent = Astro.url.searchParams.has('enviado');
const error = Astro.url.searchParams.get('error');
---

<form id="formulario" action="/api/contact" method="post" class="card scroll-mt-28 space-y-5 p-5 sm:p-8" data-contact-form novalidate>
	<div>
		<h2 class="text-2xl">Envíame un mensaje</h2>
		<p class="mt-1 text-sm text-gray-300">Elige por dónde quieres que me llegue. Todo se envía desde aquí mismo.</p>
	</div>

	<fieldset class="channel-pill">
		<legend class="sr-only">Enviar por</legend>
		<label><input type="radio" name="channel" value="email" checked /><span>Correo</span></label>
		<label><input type="radio" name="channel" value="whatsapp" /><span>WhatsApp</span></label>
		<label><input type="radio" name="channel" value="both" /><span>Ambos</span></label>
	</fieldset>

	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label for="cf-name" class="field-label">Nombre <span class="req">*</span></label>
			<input id="cf-name" name="name" class="field" required maxlength="100" autocomplete="name" />
		</div>
		<div>
			<label for="cf-company" class="field-label">Empresa <span class="opt">(opcional)</span></label>
			<input id="cf-company" name="company" class="field" maxlength="120" autocomplete="organization" />
		</div>
	</div>

	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label for="cf-email" class="field-label">Correo <span class="req" data-email-req>*</span><span class="opt" data-email-opt hidden>(o teléfono)</span></label>
			<input id="cf-email" name="email" type="email" class="field" required maxlength="200" autocomplete="email" />
		</div>
		<div>
			<label for="cf-phone" class="field-label">Teléfono <span class="opt">(opcional)</span></label>
			<input id="cf-phone" name="phone" type="tel" class="field" maxlength="30" autocomplete="tel" placeholder="+506 …" />
		</div>
	</div>

	<div>
		<label for="cf-subject" class="field-label">Asunto <span class="req">*</span></label>
		<input id="cf-subject" name="subject" class="field" required maxlength="150" list="cf-subjects" />
		<datalist id="cf-subjects">
			<option value="Oportunidad laboral"></option>
			<option value="Propuesta de proyecto"></option>
			<option value="Colaboración"></option>
			<option value="Consulta general"></option>
		</datalist>
	</div>

	<div>
		<label for="cf-message" class="field-label">Mensaje <span class="req">*</span></label>
		<textarea id="cf-message" name="message" rows="6" class="field resize-y" required maxlength="5000"></textarea>
	</div>

	<!-- Honeypot: invisible para personas -->
	<div class="hidden" aria-hidden="true">
		<label>No llenar <input name="website" tabindex="-1" autocomplete="off" /></label>
	</div>

	{siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-language="es" data-theme="auto"></div>}

	<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
		<p data-status role="status" aria-live="polite" class:list={['text-sm', sent ? 'text-link' : 'text-red-500']}>
			{sent ? '¡Gracias! Tu mensaje fue enviado.' : error}
		</p>
		<button type="submit" class="btn btn-primary !px-6 !py-3 text-base">
			<Icon name="send" size={16} />
			<span data-submit-label>Enviar mensaje</span>
		</button>
	</div>
</form>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
	.req {
		color: var(--link-color);
	}

	.opt {
		color: var(--gray-400);
		font-family: var(--font-body);
		font-weight: 400;
	}

	/* Selector de canal con el estilo del menú de la plantilla */
	.channel-pill {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.125rem;
		margin-inline: 0;
		padding: 0.3rem;
		border: 1px solid var(--gray-800);
		border-radius: 999rem;
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		box-shadow: var(--shadow-sm);
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--tpl-text-sm);
	}

	.channel-pill label {
		position: relative;
		cursor: pointer;
	}

	.channel-pill input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.channel-pill span {
		display: inline-block;
		padding: 0.45rem 1rem;
		border-radius: 999rem;
		color: var(--gray-300);
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.channel-pill label:hover span {
		color: var(--gray-100);
		background-color: var(--accent-subtle-overlay);
	}

	.channel-pill input:checked + span {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}

	.channel-pill input:focus-visible + span {
		outline: 2px solid var(--accent-regular);
		outline-offset: 2px;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	if (form) {
		const status = form.querySelector<HTMLElement>('[data-status]')!;
		const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
		const email = form.querySelector<HTMLInputElement>('#cf-email')!;
		const phone = form.querySelector<HTMLInputElement>('#cf-phone')!;
		const emailReq = form.querySelector<HTMLElement>('[data-email-req]')!;
		const emailOpt = form.querySelector<HTMLElement>('[data-email-opt]')!;

		const channel = () => (new FormData(form).get('channel') as string) || 'email';
		const setStatus = (msg: string, ok: boolean) => {
			status.textContent = msg;
			status.className = `text-sm ${ok ? 'text-link' : 'text-red-500'}`;
		};

		// Con WhatsApp basta un correo o un teléfono para poder responder.
		const sync = () => {
			const c = channel();
			const onlyWa = c === 'whatsapp';
			email.required = !onlyWa;
			emailReq.hidden = onlyWa;
			emailOpt.hidden = !onlyWa;
			label.textContent = c === 'email' ? 'Enviar por correo' : c === 'whatsapp' ? 'Enviar por WhatsApp' : 'Enviar por ambos';
		};
		form.addEventListener('change', (e) => {
			if ((e.target as HTMLInputElement).name === 'channel') sync();
		});
		sync();

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}
			if (channel() === 'whatsapp' && !email.value.trim() && !phone.value.trim()) {
				setStatus('Indica un correo o un teléfono para poder responderte.', false);
				phone.focus();
				return;
			}

			button.disabled = true;
			setStatus('Enviando…', true);
			try {
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});
				const data = (await res.json()) as { ok: boolean; message: string };
				setStatus(data.message, data.ok);
				if (data.ok) {
					form.reset();
					sync();
				}
			} catch {
				setStatus('No se pudo enviar. Revisa tu conexión e intenta de nuevo.', false);
			} finally {
				button.disabled = false;
				// @ts-expect-error turnstile lo carga el script de Cloudflare
				window.turnstile?.reset();
			}
		});
	}
</script>
