---
import type { SkillGroup } from '../lib/content';
import { techIcon } from '../lib/tech';
import TechPill from './TechPill.astro';

interface Props {
	groups: SkillGroup[];
}
const { groups } = Astro.props;
// Los grupos sin tecnologías reconocidas (habilidades blandas, fortalezas, idiomas) se muestran como texto.
const isTech = (g: SkillGroup) => g.items.some((i) => techIcon(i));
const tech = groups.filter(isTech);
const soft = groups.filter((g) => !isTech(g));
---

<dl class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
	{
		tech.map((g) => (
			<div>
				<dt class="text-base font-medium text-gray-0" style="font-family: var(--font-brand)">{g.name}</dt>
				<dd class="mt-3 flex flex-wrap gap-1.5">
					{g.items.map((item) => (
						<TechPill name={item} />
					))}
				</dd>
			</div>
		))
	}
</dl>

{
	soft.length > 0 && (
		<dl class="card mt-12 grid gap-x-10 gap-y-8 p-6 sm:grid-cols-2 sm:p-8 lg:grid-cols-3">
			{soft.map((g) => (
				<div>
					<dt class="text-base font-medium text-gray-0" style="font-family: var(--font-brand)">{g.name}</dt>
					<dd class="mt-3">
						<ul class="space-y-1.5 text-sm text-gray-300">
							{g.items.map((item) => (
								<li class="flex items-center gap-2">
									<span class="size-1.5 shrink-0 rounded-full bg-accent-regular" aria-hidden="true" />
									{item}
								</li>
							))}
						</ul>
					</dd>
				</div>
			))}
		</dl>
	)
}
