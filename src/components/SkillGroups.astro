---
import type { SkillGroup } from '../lib/content';

interface Props {
	groups: SkillGroup[];
}
const { groups } = Astro.props;
---

<dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
	{
		groups.map((g) => (
			<div>
				<dt class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">{g.name}</dt>
				<dd class="mt-3 flex flex-wrap gap-1.5">
					{g.items.map((item) => (
						<span class="chip">{item}</span>
					))}
				</dd>
			</div>
		))
	}
</dl>
