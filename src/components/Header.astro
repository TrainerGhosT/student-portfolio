---
import BrandMark from './BrandMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './UiIcon.astro';

interface Props {
	name: string;
}
const { name } = Astro.props;

const links = [
	{ label: 'Sobre mí', href: '/#sobre-mi' },
	{ label: 'Experiencia', href: '/#experiencia' },
	{ label: 'Proyectos', href: '/proyectos' },
	{ label: 'Educación', href: '/#educacion' },
	{ label: 'Contacto', href: '/contacto' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => !href.includes('#') && (path === href || path.startsWith(href + '/'));
---

<header class="site-header sticky top-0 z-40">
	<div class="container-page flex h-16 items-center justify-between gap-4 sm:h-20">
		<a href="/" class="flex items-center gap-2.5 text-gray-0 no-underline" style="font-family: var(--font-brand); font-weight: 500;">
			<BrandMark />
			<span class="text-base sm:text-lg">{name}</span>
		</a>

		<nav aria-label="Principal" class="nav-pill hidden md:flex">
			{
				links.map((l) => (
					<a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined} class="nav-link">
						{l.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<a href="/cv" class="btn btn-secondary hidden !px-4 !py-2 sm:inline-flex">
				<Icon name="file" size={16} /> CV
			</a>
			<ThemeToggle />

			<details class="group relative md:hidden">
				<summary
					class="btn btn-secondary !size-10 !p-0 list-none [&::-webkit-details-marker]:hidden"
					aria-label="Abrir menú"
				>
					<Icon name="menu" class="group-open:hidden" />
					<Icon name="x" class="hidden group-open:block" />
				</summary>
				<nav aria-label="Menú móvil" class="card absolute right-0 mt-2 flex w-60 flex-col gap-1 bg-gray-999 p-2 shadow-lg">
					{
						links.map((l) => (
							<a href={l.href} class="mobile-link">
								{l.label}
							</a>
						))
					}
					<a href="/cv" class="mobile-link">Ver CV</a>
				</nav>
			</details>
		</div>
	</div>
</header>

<style>
	/* Transparente sobre el fondo de la plantilla; se vuelve sólida al hacer scroll. */
	.site-header {
		border-bottom: 1px solid transparent;
		transition:
			background-color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.site-header.scrolled {
		background: hsla(var(--gray-999-basis), 0.75);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
		border-bottom-color: var(--gray-800);
	}

	/* Menú tipo píldora de la plantilla */
	.nav-pill {
		position: relative;
		gap: 0.125rem;
		padding: 0.375rem;
		border-radius: 999rem;
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		box-shadow: var(--shadow-md);
		font-family: var(--font-brand);
		font-weight: 500;
	}

	.nav-pill::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: var(--gradient-stroke);
		border-radius: 999rem;
		z-index: -1;
	}

	.nav-link {
		padding: 0.45rem 0.95rem;
		border-radius: 999rem;
		font-size: var(--tpl-text-sm);
		color: var(--gray-300);
		text-decoration: none;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.nav-link:hover,
	.nav-link:focus-visible {
		color: var(--gray-100);
		background-color: var(--accent-subtle-overlay);
	}

	.nav-link[aria-current='page'] {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}

	.mobile-link {
		padding: 0.6rem 0.9rem;
		border-radius: 0.75rem;
		color: var(--gray-200);
		text-decoration: none;
		font-family: var(--font-brand);
	}

	.mobile-link:hover {
		background: var(--accent-subtle-overlay);
		color: var(--gray-0);
	}
</style>

<script>
	const header = document.querySelector('.site-header');
	const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
	addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// Cierra el menú móvil al elegir una opción.
	document.querySelectorAll('.site-header details nav a').forEach((a) =>
		a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
	);
</script>
