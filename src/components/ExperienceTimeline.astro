---
import { formatRange, renderMarkdown, type Doc, type Experience } from '../lib/content';
import TechPill from './TechPill.astro';

interface Props {
	items: Doc<Experience>[];
}
const { items } = Astro.props;
---

<ol class="timeline relative space-y-10 pl-7 sm:pl-9">
	{
		items.map(({ data, body }) => (
			<li class="relative">
				<span class:list={['dot', { current: !data.end }]} aria-hidden="true" />
				<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
					<h3 class="text-xl">{data.role}</h3>
					<p class="shrink-0 text-sm text-gray-400 tabular-nums">{formatRange(data.start, data.end)}</p>
				</div>
				<p class="mt-1 text-sm text-gray-300">
					<span class="font-medium text-gray-100">{data.company}</span>
					{data.employmentType && <span> · {data.employmentType}</span>}
					{data.location && <span> · {data.location}</span>}
				</p>
				{body && <div class="prose-portfolio mt-4 text-[0.95rem]" set:html={renderMarkdown(body)} />}
				{data.stack && data.stack.length > 0 && (
					<div class="mt-4 flex flex-wrap gap-1.5" aria-label="Tecnologías">
						{data.stack.map((t) => (
							<TechPill name={t} />
						))}
					</div>
				)}
			</li>
		))
	}
</ol>

<style>
	.timeline::before {
		content: '';
		position: absolute;
		top: 0.4rem;
		bottom: 0.4rem;
		left: 0.35rem;
		width: 2px;
		border-radius: 999rem;
		background: linear-gradient(var(--accent-regular), var(--gray-800));
	}

	.dot {
		position: absolute;
		top: 0.45rem;
		left: -1.75rem;
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 999rem;
		background: var(--gray-999);
		border: 2px solid var(--gray-600);
	}

	.dot.current {
		background: var(--accent-regular);
		border-color: var(--accent-regular);
		box-shadow: 0 0 0 5px var(--accent-overlay);
	}

	@media (min-width: 40rem) {
		.dot {
			left: -2.25rem;
		}
	}
</style>
