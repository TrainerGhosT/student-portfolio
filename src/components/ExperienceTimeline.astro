---
import { formatRange, renderMarkdown, type Doc, type Experience } from '../lib/content';
import TechPill from './TechPill.astro';

interface Props {
	items: Doc<Experience>[];
}
const { items } = Astro.props;
---

<ol class="timeline">
	{
		items.map(({ data, body }) => (
			<li class:list={['item', { current: !data.end }]}>
				<span class="dot" aria-hidden="true" />
				<div class="box entry">
					<div class="head">
						<h3>{data.role}</h3>
						<p class="dates">{formatRange(data.start, data.end)}</p>
					</div>
					<p class="company">
						<strong>{data.company}</strong>
						{data.employmentType && <span> · {data.employmentType}</span>}
						{data.location && <span> · {data.location}</span>}
					</p>
					{body && <div class="prose-portfolio body" set:html={renderMarkdown(body)} />}
					{data.stack && data.stack.length > 0 && (
						<div class="stack-list" aria-label="Tecnologías">
							{data.stack.map((t) => (
								<TechPill name={t} />
							))}
						</div>
					)}
				</div>
			</li>
		))
	}
</ol>

<style>
	.timeline {
		position: relative;
		display: grid;
		gap: 2rem;
		list-style: none;
		padding: 0 0 0 1.75rem;
		margin: 0;
	}

	.timeline::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 0.4rem;
		width: 2px;
		background: linear-gradient(var(--accent-regular), var(--gray-800));
		border-radius: 999rem;
	}

	.item {
		position: relative;
	}

	.dot {
		position: absolute;
		top: 1.9rem;
		left: -1.75rem;
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 999rem;
		background: var(--gray-999);
		border: 2px solid var(--gray-600);
	}

	.current .dot {
		background: var(--accent-regular);
		border-color: var(--accent-regular);
		box-shadow: 0 0 0 5px var(--accent-overlay);
	}

	.entry {
		padding: 1.5rem;
	}

	.head {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	h3 {
		font-size: var(--text-lg);
	}

	.dates {
		color: var(--gray-400);
		font-size: var(--text-sm);
		font-variant-numeric: tabular-nums;
	}

	.company {
		margin-top: 0.35rem;
		color: var(--gray-300);
	}

	.company strong {
		color: var(--gray-100);
	}

	.body {
		margin-top: 1rem;
		color: var(--gray-300);
	}

	.stack-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	@media (min-width: 50em) {
		.timeline {
			padding-left: 2.5rem;
		}

		.dot {
			left: -2.5rem;
		}

		.entry {
			padding: 2rem 2.5rem;
		}

		.head {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
			gap: 1.5rem;
		}

		h3 {
			font-size: var(--text-xl);
		}

		.dates {
			flex-shrink: 0;
		}
	}
</style>
