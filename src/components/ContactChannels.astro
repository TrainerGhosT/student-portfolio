---
import { renderSVG } from 'uqr';
import type { Profile } from '../lib/content';
import { whatsappUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';
import Pill from './Pill.astro';

interface Props {
	profile: Profile;
	/** 'cards': correo, teléfono y redes · 'whatsapp': tarjeta de WhatsApp con QR */
	part: 'cards' | 'whatsapp';
}
const { profile, part } = Astro.props;

const waUrl = profile.whatsapp ? whatsappUrl(profile.whatsapp, profile.whatsappMessage) : null;
const waQr = waUrl ? renderSVG(waUrl, { border: 1, whiteColor: '#ffffff', blackColor: '#141925' }) : null;

const cards = [
	profile.phone && {
		type: 'Celular',
		value: profile.phone,
		icon: 'device-mobile' as const,
		href: `tel:${profile.phone.replace(/[^\d+]/g, '')}`,
	},
	profile.email && { type: 'Correo', value: profile.email, icon: 'envelope-simple' as const, href: `mailto:${profile.email}` },
	profile.linkedin && {
		type: 'LinkedIn',
		value: profile.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
		icon: 'linkedin-logo' as const,
		href: profile.linkedin,
		external: true,
	},
	profile.github && {
		type: 'GitHub',
		value: profile.github.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
		icon: 'github-logo' as const,
		href: profile.github,
		external: true,
	},
].filter(Boolean) as {
	type: string;
	value: string;
	icon: 'device-mobile' | 'envelope-simple' | 'linkedin-logo' | 'github-logo';
	href: string;
	external?: boolean;
}[];
---

<div class="channels">
	{
		part === 'whatsapp' && waUrl && (
			<div class="contact-card whatsapp">
				<div class="wa-info">
					<Icon icon="whatsapp-logo" size="1.8rem" gradient />
					<Pill>WhatsApp</Pill>
					<p>Escríbeme directamente; normalmente respondo el mismo día.</p>
					<a class="wa-button" href={waUrl} target="_blank" rel="noopener noreferrer">
						<Icon icon="whatsapp-logo" size="1.2em" /> Abrir chat
					</a>
				</div>
				{waQr && (
					<div class="qr">
						<div class="qr-code" set:html={waQr} />
						<span>Escanéalo desde tu teléfono</span>
					</div>
				)}
			</div>
		)
	}

	{part === 'cards' && <div class="contact-cards">
		{
			cards.map((c) => (
				<a
					class="contact-card"
					href={c.href}
					target={c.external ? '_blank' : undefined}
					rel={c.external ? 'noopener noreferrer' : undefined}
				>
					<Icon icon={c.icon} size="1.8rem" gradient />
					<Pill>{c.type}</Pill>
					<span class="value">{c.value}</span>
				</a>
			))
		}
	</div>}
</div>

<style>
	.channels {
		display: grid;
		gap: 1.5rem;
	}

	.contact-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.5rem;
	}

	.contact-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding: 1.5rem;
		text-align: center;
		text-decoration: none;
		color: var(--gray-200);
		background: var(--gray-999_40);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		box-shadow: var(--shadow-sm);
		transition: box-shadow var(--theme-transition);
	}

	a.contact-card:hover {
		box-shadow: var(--shadow-md);
	}

	.value {
		color: var(--link-color);
		word-break: break-word;
	}

	.whatsapp {
		gap: 1.5rem;
		padding: 2rem 1.5rem;
	}

	.wa-info {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		max-width: 22rem;
	}

	.wa-info p {
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	.wa-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.25rem;
		padding: 0.6rem 1.4rem;
		border-radius: 999rem;
		background: #25d366;
		color: #0b1a10;
		font-weight: 700;
		text-decoration: none;
		box-shadow: var(--shadow-md);
	}

	.wa-button:hover {
		background: #1ebe5b;
	}

	.qr {
		display: none;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		color: var(--gray-400);
	}

	.qr-code {
		width: 7.5rem;
		padding: 0.25rem;
		background: #fff;
		border-radius: 0.75rem;
		box-shadow: var(--shadow-sm);
	}

	.qr-code :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (min-width: 50em) {
		.qr {
			display: flex;
		}
	}
</style>
