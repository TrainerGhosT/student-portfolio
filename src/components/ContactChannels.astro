---
import type { Profile } from '../lib/content';
import Icon from './UiIcon.astro';

interface Props {
	profile: Profile;
}
const { profile } = Astro.props;

const clean = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const channels = [
	profile.email && { icon: 'mail' as const, label: 'Correo', value: profile.email, href: `mailto:${profile.email}` },
	profile.linkedin && { icon: 'linkedin' as const, label: 'LinkedIn', value: clean(profile.linkedin), href: profile.linkedin, external: true },
	profile.github && { icon: 'github' as const, label: 'GitHub', value: clean(profile.github), href: profile.github, external: true },
].filter(Boolean) as { icon: 'mail' | 'linkedin' | 'github'; label: string; value: string; href: string; external?: boolean }[];
---

<div class="space-y-4">
	<ul class="card divide-y divide-gray-800 overflow-hidden">
		{
			channels.map((c) => (
				<li>
					<a
						href={c.href}
						target={c.external ? '_blank' : undefined}
						rel={c.external ? 'noopener noreferrer' : undefined}
						class="channel flex items-center gap-4 px-5 py-4 no-underline"
					>
						<span class="icon-box">
							<Icon name={c.icon} size={18} />
						</span>
						<span class="min-w-0">
							<span class="block text-xs text-gray-400">{c.label}</span>
							<span class="block truncate text-sm font-medium text-gray-0">{c.value}</span>
						</span>
						{c.external && <Icon name="external" size={14} class="ml-auto text-gray-500" />}
					</a>
				</li>
			))
		}
	</ul>

	<div class="card p-5 text-sm text-gray-300">
		<p class="font-medium text-gray-0" style="font-family: var(--font-brand)">¿Prefieres WhatsApp?</p>
		<p class="mt-1">
			Elige «WhatsApp» en el formulario y el mensaje me llega directo al teléfono, sin salir de esta página.
		</p>
	</div>
</div>

<style>
	.channel {
		transition: background-color var(--theme-transition);
	}

	.channel:hover,
	.channel:focus-visible {
		background-color: var(--accent-subtle-overlay);
	}

	.icon-box {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		flex-shrink: 0;
		border-radius: 0.75rem;
		color: var(--link-color);
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		border: 1px solid var(--gray-800);
	}
</style>
