---
import { renderSVG } from 'uqr';
import type { Profile } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
	profile: Profile;
}
const { profile } = Astro.props;

const waUrl = profile.whatsapp
	? `https://wa.me/${profile.whatsapp.replace(/\D/g, '')}${profile.whatsappMessage ? `?text=${encodeURIComponent(profile.whatsappMessage)}` : ''}`
	: null;
const waQr = waUrl ? renderSVG(waUrl, { border: 1, pixelSize: 4, whiteColor: '#ffffff', blackColor: '#18181b' }) : null;

const channels = [
	profile.email && { icon: 'mail' as const, label: 'Correo', value: profile.email, href: `mailto:${profile.email}` },
	profile.phone && { icon: 'phone' as const, label: 'Teléfono', value: profile.phone, href: `tel:${profile.phone.replace(/[^\d+]/g, '')}` },
	profile.linkedin && { icon: 'linkedin' as const, label: 'LinkedIn', value: profile.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''), href: profile.linkedin, external: true },
	profile.github && { icon: 'github' as const, label: 'GitHub', value: profile.github.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''), href: profile.github, external: true },
].filter(Boolean) as { icon: 'mail' | 'phone' | 'linkedin' | 'github'; label: string; value: string; href: string; external?: boolean }[];
---

<div class="space-y-4">
	{
		waUrl && (
			<div class="card overflow-hidden">
				<div class="p-5">
					<div class="flex items-start gap-4">
						<span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#25D366]/15 text-[#128C7E] dark:text-[#25D366]">
							<Icon name="whatsapp" size={20} />
						</span>
						<div class="min-w-0 flex-1">
							<p class="font-medium text-zinc-900 dark:text-zinc-100">WhatsApp</p>
							<p class="mt-0.5 text-sm text-zinc-600 dark:text-zinc-400">La forma más rápida de contactarme.</p>
						</div>
					</div>
					<div class="mt-4 flex items-end justify-between gap-4">
						<a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn bg-[#25D366] whitespace-nowrap text-zinc-950 hover:bg-[#1ebe5b]">
							<Icon name="whatsapp" size={16} /> Abrir chat
						</a>
						{waQr && (
							<div class="hidden items-center gap-3 sm:flex">
								<p class="max-w-[7rem] text-right text-xs text-zinc-500">O escanea el código desde tu teléfono</p>
								<div class="w-20 overflow-hidden rounded-md border border-zinc-200 dark:border-zinc-700 [&>svg]:h-auto [&>svg]:w-full" set:html={waQr} />
							</div>
						)}
					</div>
				</div>
			</div>
		)
	}

	<ul class="card divide-y divide-zinc-200 dark:divide-zinc-800">
		{
			channels.map((c) => (
				<li>
					<a
						href={c.href}
						target={c.external ? '_blank' : undefined}
						rel={c.external ? 'noopener noreferrer' : undefined}
						class="flex items-center gap-4 px-5 py-4 transition-colors hover:bg-zinc-50 dark:hover:bg-zinc-800/40"
					>
						<span class="inline-flex size-9 items-center justify-center rounded-lg bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
							<Icon name={c.icon} size={18} />
						</span>
						<span class="min-w-0">
							<span class="block text-xs text-zinc-500 dark:text-zinc-400">{c.label}</span>
							<span class="block truncate text-sm font-medium text-zinc-900 dark:text-zinc-100">{c.value}</span>
						</span>
						{c.external && <Icon name="external" size={14} class="ml-auto text-zinc-400" />}
					</a>
				</li>
			))
		}
	</ul>
</div>
