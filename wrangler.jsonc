{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dylan-portfolio",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Bucket R2 con el contenido (markdown), imágenes, CV y mensajes de contacto.
	"r2_buckets": [
		{
			"binding": "CONTENT",
			"bucket_name": "portfolio-content"
		}
	],
	// Cron diario (8:00 a. m. de Costa Rica): revisa si CallMeBot volvió a tener cupos.
	"triggers": {
		"crons": [
			"0 14 * * *"
		]
	},
	// Límite de envíos del formulario de contacto: 3 por minuto por IP.
	"ratelimits": [
		{
			"name": "CONTACT_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 3,
				"period": 60
			}
		}
	],
	// Variables públicas (no secretas). Los secretos van con `wrangler secret put`.
	"vars": {
		"ADMIN_EMAIL": "dylanmont15@gmail.com",
		"ACCESS_TEAM_DOMAIN": "https://TU-EQUIPO.cloudflareaccess.com",
		"ACCESS_AUD": "",
		"CONTACT_FROM": "Portafolio Dylan Montoya <notificaciones@dmontoya.dev>",
		"CONTACT_TO": "contacto@dmontoya.dev",
		"CONTACT_CC": "",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFax39IV6SqwhsNF"
	},
	// Dominio propio (la zona dmontoya.dev debe estar en la misma cuenta de Cloudflare).
	"routes": [
		{
			"pattern": "dmontoya.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.dmontoya.dev",
			"custom_domain": true
		}
	],
	// Sin subdominio *.workers.dev: el sitio solo responde en dmontoya.dev.
	"workers_dev": false
}